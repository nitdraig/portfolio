---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import type { projects as projectsData } from "../../data/projects";

type Project = (typeof projectsData)[number];

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const t = ui[locale].projectDetail;

function statusLabel(status: string | undefined): string {
  if (status === "active") return t.statusActive;
  if (status === "archived") return t.statusArchived;
  return t.statusDevelopment;
}
---

<section class="hero-project">
  <div class="hero-project-inner">
    <span class="hero-project-badge">{project.featured ? t.featured : t.project}</span>
    <h1 class="hero-project-title">{project.title[locale]}</h1>
    <p class="hero-project-short">{project.shortDescription[locale]}</p>
    <p class="hero-project-desc">{project.description[locale]}</p>

    <div class="hero-project-meta">
      {project.year && (
        <div class="hero-project-meta-item">
          <span class="hero-project-meta-value">{project.year}</span>
          <span class="hero-project-meta-label">{t.year}</span>
        </div>
      )}
      <div class="hero-project-meta-item">
        <span class="hero-project-meta-value">{statusLabel(project.status)}</span>
        <span class="hero-project-meta-label">{t.status}</span>
      </div>
      {project.highlightMetric && (
        <div class="hero-project-meta-item hero-project-metric">
          <span class="hero-project-metric-value">{project.highlightMetric[locale]}</span>
        </div>
      )}
    </div>

    <div class="hero-project-tags">
      {project.tags?.map((tag) => (
        <span class="hero-project-tag">{tag}</span>
      ))}
    </div>

    <div class="hero-project-actions">
      <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
        {t.viewDemo}
      </a>
      {project.githubUrl ? (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          {t.sourceCode}
        </a>
      ) : (
        <span class="btn-disabled">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          {t.sourceUnavailable}
        </span>
      )}
    </div>

    <div class="hero-project-image reveal">
      <img
        src={project.image}
        alt={project.title[locale]}
        width="900"
        height="800"
      />
    </div>
  </div>
</section>

<style>
  .hero-project {
    background: transparent;
    padding-top: 5rem;
  }

  .hero-project-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    text-align: center;
  }

  .hero-project-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-project-title {
    font-family: var(--font-grotesk);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 1rem;
    text-align: center;
  }

  .hero-project-short {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--color-text-dim);
    margin: 0 0 0.5rem;
    line-height: 1.5;
    text-align: center;
  }

  .hero-project-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text-faint);
    margin: 0 0 1.5rem;
    line-height: 1.6;
    text-align: center;
  }

  .hero-project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 1.5rem;
    justify-content: center;
  }

  .hero-project-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-project-meta-value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-project-meta-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-project-metric-value {
    font-family: var(--font-grotesk);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .hero-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .hero-project-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
  }

  .hero-project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-secondary:hover { background: var(--color-bg-panel); }

  .btn-disabled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-faint);
    border: 1px solid var(--color-line);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hero-project-image {
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .hero-project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .hero-project-inner {
      margin: 0 1rem;
      padding: 2rem 1.25rem 3rem;
      border-radius: 12px;
    }
  }
</style>
