---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import type { projects as projectsData } from "../../data/projects";

type Project = (typeof projectsData)[number];

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const t = ui[locale].projectDetail;
const results = project.results?.[locale] ?? [];
---

<section class="project-details">
  <div class="project-details-inner reveal">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h3 class="project-details-heading">{t.challenge}</h3>
          <p class="project-details-body">
            {project.challenge?.[locale] ?? t.empty.challenge}
          </p>
        </div>

        <div>
          <h3 class="project-details-heading">{t.solution}</h3>
          <p class="project-details-body">
            {project.solution?.[locale] ?? t.empty.solution}
          </p>
        </div>

        <div>
          <h3 class="project-details-heading">{t.results}</h3>
          <div class="grid md:grid-cols-2 gap-4">
            {results.length > 0 ? (
              results.map((result) => (
                <div class="project-details-result">
                  <div class="project-details-check">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                  </div>
                  <span class="project-details-result-text">{result}</span>
                </div>
              ))
            ) : (
              <p class="project-details-faint">{t.empty.results}</p>
            )}
          </div>
        </div>
      </div>

      <div class="space-y-8">
        <div class="project-details-sidebar">
          <h4 class="project-details-sidebar-title">{t.technologies}</h4>
          <div class="flex flex-wrap gap-2">
            {project.tags?.length ? (
              project.tags.map((tech) => (
                <span class="project-details-tech">{tech}</span>
              ))
            ) : (
              <p class="project-details-faint">{t.empty.tags}</p>
            )}
          </div>
        </div>

        <div class="project-details-sidebar">
          <div class="space-y-3">
            <h4 class="project-details-sidebar-title">{t.links}</h4>
            {project.demoUrl && (
              <a
                href={project.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="project-details-link project-details-link-primary"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                {t.liveDemo}
              </a>
            )}
            {project.githubUrl ? (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="project-details-link project-details-link-secondary"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                {t.sourceCode}
              </a>
            ) : (
              <span class="project-details-link project-details-link-disabled">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                {t.sourceUnavailable}
              </span>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .project-details {
    background: transparent;
  }

  .project-details-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid var(--color-line);
    border-radius: 16px;
  }

  .project-details-heading {
    font-family: var(--font-grotesk);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .project-details-body {
    font-family: var(--font-sans);
    color: var(--color-text-dim);
    line-height: 1.7;
    margin: 0;
  }

  .project-details-result {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    transition: transform 0.2s;
  }
  .project-details-result:hover { transform: scale(1.02); }

  .project-details-check {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-accent-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .project-details-result-text {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--color-text);
  }

  .project-details-sidebar {
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .project-details-sidebar-title {
    font-family: var(--font-grotesk);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .project-details-tech {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
  }

  .project-details-faint {
    color: var(--color-text-faint);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    margin: 0;
  }

  .project-details-link {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .project-details-link-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .project-details-link-primary:hover { opacity: 0.85; }

  .project-details-link-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-line);
  }
  .project-details-link-secondary:hover { background: var(--color-bg); }

  .project-details-link-disabled {
    background: transparent;
    color: var(--color-text-faint);
    border: 1px solid var(--color-line);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .mr-2 { margin-right: 0.5rem; }

  @media (max-width: 720px) {
    .project-details-inner {
      margin: 0 1rem;
      padding: 2rem 1.25rem;
      border-radius: 12px;
    }
  }
</style>
