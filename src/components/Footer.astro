---
import type { Locale } from "../i18n/ui";
import { ui } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].footer;

const socials = [
  { label: "GitHub", url: "https://github.com/nitdraig" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/avellaneda-agustin/" },
  { label: "Email", url: "#email-contact", isEmail: true },
];
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <h3 class="site-footer-name">{t.name}</h3>

      <div class="site-footer-socials">
        {
          socials.map((social) => (
            <a
              href={social.url}
              target={social.isEmail ? undefined : "_blank"}
              rel={social.isEmail ? undefined : "noopener noreferrer"}
              aria-label={social.label}
              class="site-footer-social"
              data-email-contact={social.isEmail ? "" : undefined}
            >
              {social.label === "GitHub" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              )}
              {social.label === "LinkedIn" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              )}
              {social.label === "Email" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <hr class="site-footer-divider" />

    <div class="site-footer-bottom">
      <p>{t.copyright}</p>
      <p>
        {t.ceoLine}
        <a href="https://www.excelso.xyz" target="_blank" class="site-footer-excelso"> {t.excelso}</a>
      </p>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ locale }}>
(function() {
  var emailBtn = document.querySelector('[data-email-contact]');
  if (!emailBtn) return;
  emailBtn.addEventListener('click', function(e) {
    e.preventDefault();
    var original = emailBtn.getAttribute('aria-label');
    emailBtn.setAttribute('aria-label', locale === 'es' ? 'Enviando...' : 'Sending...');
    fetch('/api/send-idea', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'contact', name: 'Portfolio Visitor', email: '', message: locale === 'es' ? 'Un visitante del portfolio quiere contactarte desde el footer.' : 'A portfolio visitor wants to contact you from the footer.', page: 'footer', language: locale })
    }).then(function(r) { return r.json(); }).then(function(res) {
      emailBtn.setAttribute('aria-label', locale === 'es' ? 'Mensaje enviado!' : 'Sent!');
      setTimeout(function() { emailBtn.setAttribute('aria-label', original || 'Email'); }, 2000);
    }).catch(function() {
      emailBtn.setAttribute('aria-label', locale === 'es' ? 'Error' : 'Error');
      setTimeout(function() { emailBtn.setAttribute('aria-label', original || 'Email'); }, 2000);
    });
  });
})();
</script>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: transparent;
    border-top: 1px solid var(--color-line);
    padding: 3rem 1.5rem;
  }

  .site-footer-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .site-footer-top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .site-footer-name {
    font-family: var(--font-grotesk);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .site-footer-socials {
    display: flex;
    gap: 0.75rem;
  }

  .site-footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: var(--color-bg-panel);
    border: 1px solid var(--color-line);
    color: var(--color-text-dim);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .site-footer-social:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .site-footer-divider {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 2rem 0;
  }

  .site-footer-bottom {
    text-align: center;
    color: var(--color-text-faint);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .site-footer-bottom p {
    margin: 0;
  }

  .site-footer-excelso {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .site-footer-excelso:hover {
    opacity: 0.7;
  }

  @media (max-width: 600px) {
    .site-footer-top {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
