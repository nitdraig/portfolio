---
import type { Locale } from "../i18n/ui";
import { ui } from "../i18n/ui";
import { CONCEPTS, NODE_DATA } from "../data/nodes";
import { projects } from "../data/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const nodes = CONCEPTS.map((key) => ({
  key,
  label: NODE_DATA[key]?.title?.[locale] || key,
  tag: NODE_DATA[key]?.tag || "NODE",
}));

const projectCommands = projects.map((p) => ({
  slug: p.slug,
  label: p.title[locale],
  tag: p.industry || p.deliveryType || "PROJECT",
}));

const pages = [
  { label: t.nav.home, href: `/${locale}/`, tag: "PAGE" },
  { label: t.nav.about, href: `/${locale}/about/`, tag: "PAGE" },
  { label: t.nav.ai, href: `/${locale}/ai/`, tag: "PAGE" },
  { label: t.nav.projects, href: `/${locale}/projects/`, tag: "PAGE" },
];

const sections = [
  { label: t.nav.work || "Work", href: `/${locale}/#build`, tag: "SECTION" },
  { label: "AI", href: `/${locale}/#understand`, tag: "SECTION" },
  { label: t.nav.proof || "Proof", href: `/${locale}/#proof`, tag: "SECTION" },
  { label: t.nav.connect || "Connect", href: `/${locale}/#connect`, tag: "SECTION" },
];
---

<div id="cmdk-overlay">
  <div id="cmdk-box">
    <input id="cmdk-input" type="text" placeholder={t.orbital?.cmdbarPlaceholder || "Escribí un comando..."} />
    <div class="cmdk-list" id="cmdk-list"></div>
  </div>
</div>

<script is:inline define:vars={{ locale, nodes: JSON.stringify(nodes), projectCommands: JSON.stringify(projectCommands), pages: JSON.stringify(pages), sections: JSON.stringify(sections) }}>
(function() {
  var currentLocale = locale;
  var overlay = document.getElementById('cmdk-overlay');
  var input = document.getElementById('cmdk-input');
  var list = document.getElementById('cmdk-list');
  if (!overlay || !input || !list) return;

  var NODES = JSON.parse(nodes);
  var PROJECTS = JSON.parse(projectCommands);
  var PAGES = JSON.parse(pages);
  var SECTIONS = JSON.parse(sections);

  function isHome() {
    return location.pathname === '/' + currentLocale + '/' || location.pathname === '/';
  }

  function buildCommands() {
    var cmds = PAGES.slice();

    cmds = cmds.concat(NODES.map(function(n) {
      return {
        label: n.label,
        tag: n.tag,
        action: function() {
          if (isHome() && typeof window.__enterInspect === 'function') {
            var idx = NODES.findIndex(function(x) { return x.key === n.key; });
            window.__enterInspect(idx >= 0 ? idx : 0);
          } else {
            location.href = '/' + currentLocale + '/';
          }
        }
      };
    }));

    cmds = cmds.concat(SECTIONS.map(function(s) {
      return {
        label: s.label,
        tag: s.tag,
        action: function() {
          if (isHome() && typeof window.__enterPortfolio === 'function') {
            window.__enterPortfolio(s.href.split('#')[1] || '');
          } else {
            location.href = s.href;
          }
        }
      };
    }));

    cmds = cmds.concat(PROJECTS.map(function(p) {
      return {
        label: p.label,
        tag: p.tag,
        action: function() {
          if (isHome() && typeof window.__enterPortfolio === 'function') {
            window.__enterPortfolio('#proof');
          } else {
            location.href = '/' + currentLocale + '/projects/' + p.slug + '/';
          }
        }
      };
    }));

    return cmds;
  }

  var COMMANDS = buildCommands();
  var activeIndex = 0;

  function render(filter) {
    var f = (filter || '').toLowerCase();
    var items = COMMANDS.filter(function(c) { return c.label.toLowerCase().includes(f); });
    activeIndex = 0;
    list.innerHTML = items.map(function(c, i) {
      return '<div class="cmdk-item'+(i===0?' active':'')+'" data-idx="'+i+'"><span>'+c.label+'</span><span class="tag">'+c.tag+'</span></div>';
    }).join('') || '<div class="cmdk-item">No results</div>';

    list.querySelectorAll('.cmdk-item[data-idx]').forEach(function(el) {
      el.addEventListener('click', function() {
        var idx = Number(el.dataset.idx);
        var item = items[idx];
        if (item) { close(); item.action(); }
      });
    });
  }

  function open() {
    overlay.classList.add('show');
    input.value = '';
    render('');
    input.focus();
  }

  function close() {
    overlay.classList.remove('show');
  }

  window.__openCmdk = open;
  window.__closeCmdk = close;

  var trigger = document.getElementById('palette-trigger');
  if (trigger) trigger.addEventListener('click', open);

  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  input.addEventListener('input', function() { render(input.value); });

  window.addEventListener('keydown', function(e) {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.classList.contains('show') ? close() : open();
      return;
    }

    if (!overlay.classList.contains('show')) return;

    var items = list.querySelectorAll('.cmdk-item[data-idx]');
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = (activeIndex + 1) % items.length; updateActive(items); return; }
    if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = (activeIndex - 1 + items.length) % items.length; updateActive(items); return; }
    if (e.key === 'Enter') {
      e.preventDefault();
      var visible = Array.from(items);
      var selected = visible[activeIndex];
      if (selected) selected.click();
    }
  });

  function updateActive(items) {
    items.forEach(function(el, i) {
      el.classList.toggle('active', i === activeIndex);
    });
  }
})();
</script>
