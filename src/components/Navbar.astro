---
import type { Locale } from "../i18n/ui";
import { ui } from "../i18n/ui";
import { switchLocalePath } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const prefix = `/${locale}`;
const esPath = switchLocalePath(Astro.url, "es");
const enPath = switchLocalePath(Astro.url, "en");

const links = [
  { href: `${prefix}/#proof`, label: t.nav.work, hash: '#proof' },
  { href: `${prefix}/ai`, label: t.nav.ai, hash: null },
  { href: `${prefix}/about`, label: t.nav.about, hash: null },
];
---

<header class="site-header">
  <a href={`${prefix}/`} class="header-logo">agustin.top</a>

  <nav class="header-nav" aria-label="Main">
    {links.map((link) => (
      <a href={link.href} class="header-link" data-nav-hash={link.hash || undefined}>{link.label}</a>
    ))}
  </nav>

  <div class="header-right">
    <div class="lang-pill">
      <a
        href={enPath}
        class:list={["lang-option", { active: locale === "en" }]}
        aria-current={locale === "en" ? "page" : undefined}
      >EN</a>
      <a
        href={esPath}
        class:list={["lang-option", { active: locale === "es" }]}
        aria-current={locale === "es" ? "page" : undefined}
      >ES</a>
    </div>

    <button
      type="button"
      class="header-kbd"
      id="palette-trigger"
      aria-label="Open command palette"
    >&#8984;K</button>

    <button
      type="button"
      class="header-hamburger"
      id="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.menuToggle}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-overlay" id="mobile-menu" aria-hidden="true">
  <button class="mobile-close-btn" id="mobile-close" aria-label="Close menu">&times;</button>
  <nav class="mobile-links" aria-label="Mobile">
    {links.map((link) => (
      <a href={link.href} class="mobile-link" data-nav-hash={link.hash || undefined}>{link.label}</a>
    ))}
  </nav>
  <div class="mobile-lang">
    <a
      href={enPath}
      class:list={["mobile-lang-option", { active: locale === "en" }]}
      aria-current={locale === "en" ? "page" : undefined}
    >EN</a>
    <span class="mobile-lang-sep">/</span>
    <a
      href={esPath}
      class:list={["mobile-lang-option", { active: locale === "es" }]}
      aria-current={locale === "es" ? "page" : undefined}
    >ES</a>
  </div>
</div>

<style>
  /* ---- Header bar ---- */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    height: 60px;
    padding: 0 28px;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 50%, transparent);
  }

  .header-logo {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color .2s;
  }
  .header-logo:hover { color: var(--color-accent); }

  /* ---- Desktop nav links ---- */
  .header-nav {
    display: none;
    flex: 1;
    justify-content: center;
    gap: 28px;
  }
  @media (min-width: 768px) {
    .header-nav { display: flex; }
  }

  .header-link {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-dim);
    letter-spacing: 0.06em;
    transition: color .2s;
    padding: 4px 0;
  }
  .header-link:hover { color: var(--color-text); }

  /* ---- Right controls ---- */
  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .lang-pill {
    display: none;
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: 20px;
    padding: 2px;
  }
  @media (min-width: 768px) {
    .lang-pill { display: flex; }
  }

  .lang-option {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 16px;
    color: var(--color-text-dim);
    transition: background .2s, color .2s;
  }
  .lang-option.active {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .lang-option:hover:not(.active) { color: var(--color-text); }

  .header-kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 5px 10px;
    line-height: 1;
    transition: border-color .2s, color .2s;
  }
  @media (min-width: 768px) {
    .header-kbd { display: block; }
  }
  .header-kbd:hover { border-color: var(--color-text-faint); color: var(--color-text); }

  /* ---- Hamburger ---- */
  .header-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 6px;
    border-radius: 6px;
    transition: background .2s;
  }
  .header-hamburger:hover { background: color-mix(in srgb, var(--color-text) 8%, transparent); }
  @media (min-width: 768px) {
    .header-hamburger { display: none; }
  }

  .header-hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform .25s, opacity .25s;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .header-hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile overlay ---- */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    background: var(--color-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity .35s ease;
  }
  .mobile-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .mobile-close-btn {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 32px;
    color: var(--color-text-dim);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: color .2s, background .2s;
  }
  .mobile-close-btn:hover { color: var(--color-text); background: color-mix(in srgb, var(--color-text) 8%, transparent); }

  .mobile-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .mobile-link {
    font-family: var(--font-grotesk);
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.02em;
    transition: color .2s;
  }
  .mobile-link:hover { color: var(--color-accent); }

  .mobile-lang {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  .mobile-lang-option {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-dim);
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--color-line);
    transition: border-color .2s, color .2s, background .2s;
  }
  .mobile-lang-option.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .mobile-lang-option:hover:not(.active) { color: var(--color-text); border-color: var(--color-text-faint); }
  .mobile-lang-sep { font-family: var(--font-mono); font-size: 13px; color: var(--color-text-faint); }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const closeBtn = document.getElementById("mobile-close");

  function setOpen(open: boolean) {
    if (!btn || !menu) return;
    menu.classList.toggle("open", open);
    menu.setAttribute("aria-hidden", open ? "false" : "true");
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  }

  function isOpen() {
    return btn?.getAttribute("aria-expanded") === "true";
  }

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!isOpen());
  });

  closeBtn?.addEventListener("click", () => setOpen(false));

  menu?.addEventListener("click", (e) => {
    if (e.target === menu) setOpen(false);
  });

  /* Nav link navigation: if hero exists (index page), trigger __enterPortfolio;
     otherwise let the full-path href navigate normally */
  function handleNavClick(e: Event) {
    const link = e.currentTarget as HTMLAnchorElement;
    const hash = link.getAttribute("data-nav-hash");
    if (!hash) return;

    const hero = document.getElementById("hero");
    if (hero && typeof (window as any).__enterPortfolio === "function") {
      e.preventDefault();
      setOpen(false);
      (window as any).__enterPortfolio(hash);
    }
    // else: href is already /locale/#hash, browser navigates normally
  }

  document.querySelectorAll("[data-nav-hash]").forEach((link) => {
    link.addEventListener("click", handleNavClick);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false);
  });

  document.addEventListener("astro:page-load", () => setOpen(false));
</script>
