---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "en";
---

<BaseLayout locale={locale} title="Idea Analysis — Agustín Avellaneda" canonicalPath="/analysis" noindex>
  <main id="main">
    <div class="empty" id="empty">
      <div class="empty-icon">◇</div>
      <p>No idea to analyze.</p>
      <p class="empty-hint">Type an idea in the orbital and press Enter.</p>
      <a href={`/${locale}/`}>&larr; Back to orbit</a>
    </div>
  </main>

  <div class="mvp-panel" id="mvp-panel" aria-hidden="true" role="dialog" aria-labelledby="mvp-panel-title">
    <div class="mvp-panel-backdrop" id="mvp-panel-backdrop"></div>
    <div class="mvp-panel-shell">
      <button class="mvp-panel-close" id="mvp-panel-close" type="button" aria-label="Close">Close</button>
      <div class="mvp-panel-label">NEXT STEP</div>
      <h2 class="mvp-panel-title" id="mvp-panel-title">Let's build this MVP</h2>
      <p class="mvp-panel-hint">Leave a message and how to reach you. I'll get the analysis and reply within 24-48 hours.</p>
      <form class="mvp-panel-form" id="mvp-panel-form">
        <label class="mvp-field">
          <span>Your message</span>
          <textarea id="mvp-message" name="message" rows="4" maxlength="2000" placeholder="Share context, timeline, or what you want to build…"></textarea>
        </label>
        <div class="mvp-field-row">
          <label class="mvp-field">
            <span>Email</span>
            <input id="mvp-email" name="email" type="email" autocomplete="email" placeholder="you@email.com" />
          </label>
          <label class="mvp-field">
            <span>WhatsApp</span>
            <input id="mvp-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 …" />
          </label>
        </div>
        <p class="mvp-panel-note">I need at least an email or a WhatsApp number.</p>
        <p class="mvp-panel-error" id="mvp-panel-error" hidden></p>
        <div class="mvp-panel-actions">
          <button class="btn-primary" id="mvp-submit" type="submit">Send request</button>
          <button class="btn-secondary" id="mvp-cancel" type="button">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <div class="mvp-panel" id="pdf-panel" aria-hidden="true" role="dialog" aria-labelledby="pdf-panel-title">
    <div class="mvp-panel-backdrop" id="pdf-panel-backdrop"></div>
    <div class="mvp-panel-shell">
      <button class="mvp-panel-close" id="pdf-panel-close" type="button" aria-label="Close">Close</button>
      <div class="mvp-panel-label">DOWNLOAD PDF</div>
      <h2 class="mvp-panel-title" id="pdf-panel-title">Leave your email to download</h2>
      <p class="mvp-panel-hint">With your email I unlock the PDF and receive your interest plus the analysis so we can move forward.</p>
      <form class="mvp-panel-form" id="pdf-panel-form">
        <label class="mvp-field">
          <span>Email</span>
          <input id="pdf-email" name="email" type="email" autocomplete="email" required placeholder="you@email.com" />
        </label>
        <p class="mvp-panel-note">The document matches this page language.</p>
        <p class="mvp-panel-error" id="pdf-panel-error" hidden></p>
        <div class="mvp-panel-actions">
          <button class="btn-primary" id="pdf-submit" type="submit">Send & download</button>
          <button class="btn-secondary" id="pdf-cancel" type="button">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ locale }}>
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function(c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; });
  }
  function decodeEntities(str) {
    return String(str)
      .replace(/&nbsp;/gi, ' ')
      .replace(/&quot;/gi, '"')
      .replace(/&#0*39;/g, "'")
      .replace(/&#x0*27;/gi, "'")
      .replace(/&apos;/gi, "'")
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&amp;/gi, '&');
  }
  function formatPitchQuotes(str) {
    return String(str)
      .replace(/(te propongo|I propose)\s+'([^']+)'/gi, '$1 "$2"')
      .replace(/'([A-Za-zÁÉÍÓÚÑ][A-Za-zÁÉÍÓÚÑ0-9-]{1,40})'/g, '"$1"');
  }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function renderAnalysis() {
    var raw = sessionStorage.getItem('agustinIdeaAnalysis');
    var emptyEl = document.getElementById('empty');
    var mainEl = document.getElementById('main');
    if (!raw) { emptyEl.classList.add('show'); return; }
    var data;
    try { data = JSON.parse(raw); } catch(e) { data = null; }
    if (!data || !data.idea || typeof data.idea !== 'string') { emptyEl.classList.add('show'); return; }

    /* Strip tags and decode entities; escapeHtml runs once at render time */
    var s = function(str) {
      var text = decodeEntities(String(str)).replace(/<[^>]*>/g, '');
      return decodeEntities(text);
    };
    data.idea = s(data.idea);
    if (data.polishedIdea) data.polishedIdea = formatPitchQuotes(s(data.polishedIdea));
    if (Array.isArray(data.tags)) data.tags = data.tags.map(s);
    if (Array.isArray(data.steps)) data.steps = data.steps.map(s);
    if (Array.isArray(data.mvp)) data.mvp = data.mvp.map(s);
    if (Array.isArray(data.projects)) data.projects.forEach(function(p) { if (p.title) p.title = s(p.title); if (p.category) p.category = s(p.category); if (p.type) p.type = s(p.type); });

    var isFallback = data.source === 'fallback';
    var isRateLimit = data.source === 'rate_limit';

    var fallbackBanner = (isFallback || isRateLimit)
      ? '<div class="fallback-banner reveal" style="animation-delay:0ms">' +
        '<div class="fallback-icon">⚠</div>' +
        '<div class="fallback-text">' +
          '<strong>' + (isRateLimit ? 'Rate limit reached' : 'Local analysis') + '</strong> — ' +
          (isRateLimit
            ? pick([
              'The analysis rate limit was reached. These results were generated locally. Try again in a few minutes.',
              'The analysis service is busy. What you see below was assembled locally — the idea is valid, the AI layer is temporarily down.',
              'Usage limit reached. The analysis structure was generated without an API connection. Try again later.'
            ])
            : pick([
              'The analysis API is not available from this environment. These results were generated locally.',
              'No connection to the analysis service. These are the steps assembled from here — for the full AI analysis, email me.',
              'The analysis backend didn\'t respond. These results are an initial guide generated locally.'
            ]) +
              '<a href="mailto:me@agustin.top?subject=' + encodeURIComponent('Idea analysis: ' + data.idea.substring(0, 50)) + '"> Contact me</a>.') +
        '</div>' +
        '<button class="fallback-retry" id="retry-btn" type="button">Retry</button>' +
        '</div>'
      : '';

    var projectsHtml = (data.projects || []).slice(0,3).map(function(p) {
      return '<a class="stage-card" href="/' + locale + '/projects/' + (p.slug || '') + '/"><div class="stage-card-head"><span class="stage-card-title">' + escapeHtml(p.title) + '</span><span class="stage-card-view">View →</span></div><div class="stage-card-meta">' + escapeHtml(p.category || '') + ' · ' + escapeHtml(p.type || '') + '</div></a>';
    }).join('');

    var headline = data.polishedIdea || data.idea;
    var mvpHtml = (data.mvp || []).map(function(item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('');
    var stepsHtml = (data.steps || []).map(function(item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('');
    var tagsHtml = (data.tags || []).map(function(t) { return '<span>' + escapeHtml(t) + '</span>'; }).join('');

    mainEl.insertAdjacentHTML('beforeend',
      fallbackBanner +
      '<div class="stage-label reveal" style="animation-delay:40ms">IDEA ANALYSIS</div>' +
      '<h1 class="stage-title reveal" style="animation-delay:80ms">' + escapeHtml(headline) + '</h1>' +
      '<section class="stage-section reveal" style="animation-delay:180ms"><div class="stage-section-title">You said</div><div class="stage-text">' + escapeHtml(data.idea) + '</div></section>' +
      '<section class="stage-section reveal" style="animation-delay:280ms"><div class="stage-section-title">Inferred components</div><div class="stage-chips">' + tagsHtml + '</div></section>' +
      (stepsHtml ? '<section class="stage-section reveal" style="animation-delay:340ms"><div class="stage-section-title">Next steps</div><ul class="stage-list">' + stepsHtml + '</ul></section>' : '') +
      '<section class="stage-section reveal" style="animation-delay:420ms"><div class="stage-section-title">Projects you can explore</div><div class="stage-cards">' + (projectsHtml || '<div class="stage-text">No direct matches in the portfolio yet — this idea is a fresh direction.</div>') + '</div></section>' +
      (mvpHtml ? '<section class="stage-section reveal" style="animation-delay:500ms"><div class="stage-section-title">MVP proposal</div><ul class="stage-list">' + mvpHtml + '</ul></section>' : '') +
      '<div class="stage-actions reveal" style="animation-delay:620ms"><button class="btn-primary" id="send-idea-btn" type="button">Build this MVP</button><button class="btn-secondary" id="download-pdf-btn" type="button">Download PDF</button><a class="btn-secondary" href="/' + locale + '/">Back to orbit</a></div>' +
      '<div class="powered-by reveal" style="animation-delay:700ms"><span>Analysis powered by</span> <a href="https://flowfolio.space" target="_blank" rel="noopener"><img src="/images/flowfolio-logo.webp" alt="Flowfolio" width="72" height="20" loading="lazy" /> Flowfolio</a></div>'
    );

    var retryBtn = document.getElementById('retry-btn');
    if (retryBtn) {
      retryBtn.addEventListener('click', function() {
        sessionStorage.removeItem('agustinIdeaAnalysis');
        window.location.href = '/' + locale + '/';
      });
    }

    var PDF_UNLOCK_KEY = 'agustinPdfUnlockedEmail';

    function getUnlockedEmail() {
      try { return sessionStorage.getItem(PDF_UNLOCK_KEY) || ''; } catch (e) { return ''; }
    }
    function unlockPdfWithEmail(email) {
      try { sessionStorage.setItem(PDF_UNLOCK_KEY, email); } catch (e) {}
    }
    function triggerPdfDownload() {
      if (typeof window.downloadAnalysisPdf === 'function') {
        window.downloadAnalysisPdf(locale, data.polishedIdea || data.idea || '');
      }
    }

    var panel = document.getElementById('mvp-panel');
    var form = document.getElementById('mvp-panel-form');
    var errorEl = document.getElementById('mvp-panel-error');
    var submitBtn = document.getElementById('mvp-submit');
    var messageEl = document.getElementById('mvp-message');
    var emailEl = document.getElementById('mvp-email');
    var phoneEl = document.getElementById('mvp-phone');

    var pdfPanel = document.getElementById('pdf-panel');
    var pdfForm = document.getElementById('pdf-panel-form');
    var pdfErrorEl = document.getElementById('pdf-panel-error');
    var pdfSubmitBtn = document.getElementById('pdf-submit');
    var pdfEmailEl = document.getElementById('pdf-email');

    function openMvpPanel() {
      if (!panel) return;
      if (pdfPanel) { pdfPanel.classList.remove('show'); pdfPanel.setAttribute('aria-hidden', 'true'); }
      panel.classList.add('show');
      panel.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('locked');
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
      requestAnimationFrame(function() {
        if (messageEl) messageEl.focus();
      });
    }

    function closeMvpPanel() {
      if (!panel) return;
      panel.classList.remove('show');
      panel.setAttribute('aria-hidden', 'true');
      if (!pdfPanel || !pdfPanel.classList.contains('show')) {
        document.documentElement.classList.remove('locked');
      }
    }

    function openPdfPanel() {
      if (!pdfPanel) return;
      if (panel) { panel.classList.remove('show'); panel.setAttribute('aria-hidden', 'true'); }
      pdfPanel.classList.add('show');
      pdfPanel.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('locked');
      if (pdfErrorEl) { pdfErrorEl.hidden = true; pdfErrorEl.textContent = ''; }
      requestAnimationFrame(function() {
        if (pdfEmailEl) pdfEmailEl.focus();
      });
    }

    function closePdfPanel() {
      if (!pdfPanel) return;
      pdfPanel.classList.remove('show');
      pdfPanel.setAttribute('aria-hidden', 'true');
      if (!panel || !panel.classList.contains('show')) {
        document.documentElement.classList.remove('locked');
      }
    }

    function showPanelError(msg) {
      if (!errorEl) return;
      errorEl.hidden = false;
      errorEl.textContent = msg;
    }

    function showPdfError(msg) {
      if (!pdfErrorEl) return;
      pdfErrorEl.hidden = false;
      pdfErrorEl.textContent = msg;
    }

    var sendBtn = document.getElementById('send-idea-btn');
    if (sendBtn) {
      sendBtn.addEventListener('click', function() { openMvpPanel(); });
    }

    var downloadBtn = document.getElementById('download-pdf-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function() {
        if (getUnlockedEmail()) {
          triggerPdfDownload();
          return;
        }
        openPdfPanel();
      });
    }

    var closeBtn = document.getElementById('mvp-panel-close');
    var cancelBtn = document.getElementById('mvp-cancel');
    var backdrop = document.getElementById('mvp-panel-backdrop');
    if (closeBtn) closeBtn.addEventListener('click', closeMvpPanel);
    if (cancelBtn) cancelBtn.addEventListener('click', closeMvpPanel);
    if (backdrop) backdrop.addEventListener('click', closeMvpPanel);

    var pdfCloseBtn = document.getElementById('pdf-panel-close');
    var pdfCancelBtn = document.getElementById('pdf-cancel');
    var pdfBackdrop = document.getElementById('pdf-panel-backdrop');
    if (pdfCloseBtn) pdfCloseBtn.addEventListener('click', closePdfPanel);
    if (pdfCancelBtn) pdfCancelBtn.addEventListener('click', closePdfPanel);
    if (pdfBackdrop) pdfBackdrop.addEventListener('click', closePdfPanel);

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var message = messageEl ? messageEl.value.trim() : '';
        var email = emailEl ? emailEl.value.trim() : '';
        var phone = phoneEl ? phoneEl.value.trim() : '';

        if (!email && !phone) {
          showPanelError('Leave an email or a WhatsApp number.');
          return;
        }
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showPanelError('Invalid email.');
          return;
        }
        if (phone && !/^\+?[\d\s().-]{7,20}$/.test(phone)) {
          showPanelError('Invalid WhatsApp number.');
          return;
        }

        var origText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.textContent = 'Sending...'; submitBtn.disabled = true; }
        if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }

        fetch('/api/send-idea', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            idea: data.idea,
            polishedIdea: data.polishedIdea || '',
            tags: data.tags || [],
            steps: data.steps || [],
            mvp: data.mvp || [],
            message: message,
            email: email,
            phone: phone,
            requireContact: true,
            language: locale
          })
        }).then(function(r) { return r.json(); }).then(function(res) {
          if (res.success) {
            if (email) unlockPdfWithEmail(email);
            if (submitBtn) submitBtn.textContent = 'Sent!';
            if (sendBtn) { sendBtn.textContent = 'Request sent'; sendBtn.disabled = true; }
            setTimeout(function() {
              closeMvpPanel();
              if (submitBtn) { submitBtn.textContent = origText; submitBtn.disabled = false; }
              if (form) form.reset();
            }, 1200);
          } else {
            throw new Error(res.error || 'Error');
          }
        }).catch(function(err) {
          showPanelError(err && err.message ? err.message : 'Send failed. Try again.');
          if (submitBtn) { submitBtn.textContent = origText; submitBtn.disabled = false; }
        });
      });
    }

    if (pdfForm) {
      pdfForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = pdfEmailEl ? pdfEmailEl.value.trim() : '';
        if (!email) {
          showPdfError('Leave your email to download the PDF.');
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showPdfError('Invalid email.');
          return;
        }

        var origText = pdfSubmitBtn ? pdfSubmitBtn.textContent : '';
        if (pdfSubmitBtn) { pdfSubmitBtn.textContent = 'Sending...'; pdfSubmitBtn.disabled = true; }
        if (pdfErrorEl) { pdfErrorEl.hidden = true; pdfErrorEl.textContent = ''; }

        fetch('/api/send-idea', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            idea: data.idea,
            polishedIdea: data.polishedIdea || '',
            tags: data.tags || [],
            steps: data.steps || [],
            mvp: data.mvp || [],
            email: email,
            intent: 'pdf_download',
            requireEmail: true,
            requireContact: true,
            language: locale
          })
        }).then(function(r) { return r.json(); }).then(function(res) {
          if (res.success) {
            unlockPdfWithEmail(email);
            if (pdfSubmitBtn) pdfSubmitBtn.textContent = 'Done!';
            triggerPdfDownload();
            setTimeout(function() {
              closePdfPanel();
              if (pdfSubmitBtn) { pdfSubmitBtn.textContent = origText; pdfSubmitBtn.disabled = false; }
              if (pdfForm) pdfForm.reset();
            }, 800);
          } else {
            throw new Error(res.error || 'Error');
          }
        }).catch(function(err) {
          showPdfError(err && err.message ? err.message : 'Send failed. Try again.');
          if (pdfSubmitBtn) { pdfSubmitBtn.textContent = origText; pdfSubmitBtn.disabled = false; }
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderAnalysis);
  } else {
    renderAnalysis();
  }

  window.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    e.preventDefault();
    var pdfPanel = document.getElementById('pdf-panel');
    if (pdfPanel && pdfPanel.classList.contains('show')) {
      pdfPanel.classList.remove('show');
      pdfPanel.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('locked');
      return;
    }
    var panel = document.getElementById('mvp-panel');
    if (panel && panel.classList.contains('show')) {
      panel.classList.remove('show');
      panel.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('locked');
      return;
    }
    window.location.href = '/' + locale + '/';
  });
  </script>

  <script>
    import { buildAnalysisThankYouPdf, downloadSimplePdf } from "../../lib/pdf/simplePdf";

    window.downloadAnalysisPdf = function (locale: string, polishedIdea?: string) {
      const lang = locale === "en" ? "en" : "es";
      downloadSimplePdf(buildAnalysisThankYouPdf(lang, polishedIdea));
    };
  </script>
</BaseLayout>

<style is:global>
  main#main { position: relative; z-index: 10; max-width: 820px; margin: 0 auto; padding: 120px 32px 100px; }
  .empty { min-height: 60vh; display: none; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; }
  .empty.show { display: flex; }
  .empty-icon { font-size: 32px; color: var(--color-text-faint); margin-bottom: 4px; }
  .empty p { color: var(--color-text-dim); font-size: 15px; margin: 0; }
  .empty-hint { color: var(--color-text-faint); font-size: 13px; }
  .empty a { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); border-bottom: 1px solid var(--color-accent-dim); text-decoration: none; margin-top: 8px; }

  .fallback-banner { display: flex; align-items: flex-start; gap: 12px; background: rgba(234,179,8,0.06); border: 1px solid rgba(234,179,8,0.2); border-radius: 8px; padding: 16px 18px; margin-bottom: 48px; }
  .fallback-icon { font-size: 16px; color: #eab308; flex-shrink: 0; margin-top: 1px; }
  .fallback-text { font-size: 13px; color: var(--color-text-dim); line-height: 1.6; }
  .fallback-text strong { color: #eab308; font-weight: 600; }
  .fallback-text a { color: var(--color-accent); text-decoration: underline; text-decoration-color: var(--color-accent-dim); }
  .fallback-text a:hover { text-decoration-color: var(--color-accent); }
  .fallback-retry { flex-shrink: 0; font-family: var(--font-mono); font-size: 11px; color: #eab308; border: 1px solid rgba(234,179,8,0.3); background: transparent; padding: 6px 12px; border-radius: 6px; cursor: pointer; transition: border-color .2s; white-space: nowrap; align-self: center; }
  .fallback-retry:hover { border-color: #eab308; }

  .stage-label { font-family: var(--font-mono); font-size: 11px; color: var(--color-accent); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 12px; }
  .stage-title { font-family: var(--font-grotesk); font-size: clamp(2rem,5vw,3.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.015em; margin-bottom: 64px; }
  .stage-section { margin-bottom: 48px; }
  .stage-section-title { font-family: var(--font-mono); font-size: 10px; color: var(--color-text-faint); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 14px; }
  .stage-text { font-size: 15px; color: var(--color-text-dim); line-height: 1.65; }
  .stage-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .stage-chips span { font-family: var(--font-mono); font-size: 12px; border: 1px solid var(--color-line); padding: 6px 12px; border-radius: 20px; color: var(--color-text-dim); }
  .stage-cards { display: flex; flex-direction: column; gap: 12px; }
  .stage-card { display: block; background: var(--color-bg-panel); border: 1px solid var(--color-line); border-radius: 8px; padding: 18px; transition: border-color .2s, transform .15s; text-decoration: none; }
  .stage-card:hover { border-color: var(--color-accent-dim); transform: translateY(-1px); }
  .stage-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 6px; }
  .stage-card-title { font-family: var(--font-grotesk); font-size: 16px; font-weight: 600; color: var(--color-text); }
  .stage-card-meta { font-family: var(--font-mono); font-size: 11px; color: var(--color-accent); text-transform: uppercase; }
  .stage-card-view { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-faint); transition: color .2s; }
  .stage-card:hover .stage-card-view { color: var(--color-accent); }
  .stage-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .stage-list li { font-size: 14px; color: var(--color-text-dim); padding-left: 20px; position: relative; line-height: 1.55; }
  .stage-list li::before { content: '\2192'; position: absolute; left: 0; color: var(--color-accent); font-family: var(--font-mono); font-size: 11px; }
  .stage-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 64px; }
  .btn-primary { display: inline-block; background: var(--color-accent); color: white; font-family: var(--font-mono); font-size: 12px; font-weight: 500; padding: 10px 18px; border-radius: 6px; transition: transform .15s, box-shadow .2s; text-decoration: none; border: none; cursor: pointer; }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(59,130,246,0.25); }
  .btn-primary:disabled { opacity: .7; cursor: not-allowed; transform: none; box-shadow: none; }
  .btn-secondary { display: inline-block; background: transparent; color: var(--color-text-dim); border: 1px solid var(--color-line); font-family: var(--font-mono); font-size: 12px; padding: 10px 18px; border-radius: 6px; transition: border-color .2s, color .2s; text-decoration: none; cursor: pointer; }
  .btn-secondary:hover { border-color: var(--color-text-faint); color: var(--color-text); }

