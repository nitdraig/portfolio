# Mailprex (owner notification)
EMAIL_DESTINY=your-inbox@example.com
MAILPREX_FORM_TOKEN=your-mailprex-form-token

# SMTP (thank-you email to submitter)
# Quote values that contain spaces (Gmail app passwords).
MAILER_FROM="Agustín Avellaneda <me@agustin.top>"
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=your-smtp-user
MAILER_PASS="your smtp app password"

# Upstash Redis (contact rate limiting — recommended in production)
# Leave blank locally. Placeholders like "your-instance" are ignored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signed contact-form session (falls back to MAILPREX_FORM_TOKEN)
CONTACT_FORM_SECRET=

# Cloudflare Turnstile (required to show captcha + block spam).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Use Managed mode. Set both keys locally and in Vercel (build + runtime).

  PUBLIC_TURNSTILE_SITE_KEY=...
  TURNSTILE_SECRET_KEY=

# Portfolio analysis API
PORTFOLIO_API_TOKEN=
PORTFOLIO_API_URL=https://api.flowfolio.space/portfolio/idea
